# Copy this file to `.env` (which is gitignored) and fill in real values.
#
# OpenRouter API key — get one at https://openrouter.ai/keys
# Required for: Extractor (DeepSeek Chat), Critic + Consolidator (Llama 3.3 70B).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME

# Optional — override the OpenRouter base URL (default below).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional — for OpenRouter analytics/leaderboards attribution.
# OPENROUTER_REFERER=https://github.com/<your-handle>/contribution_extraction_framework
# OPENROUTER_TITLE=Multi-Agent Contribution Extraction

# Together AI API key — only required if you want to reproduce the
# specialized-framework results that use the fine-tuned 70B endpoint.
# Get one at https://api.together.ai/settings/api-keys
TOGETHER_API_KEY=tgp_v1_REPLACE_ME
